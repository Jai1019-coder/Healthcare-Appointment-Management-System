# =============================================================================
# Healthcare Appointment & Follow-up Manager - Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_appointments

# --- Auth ---
# Any long random string. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-secret-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- Frontend URL (used for CORS and OAuth redirect after Google login) ---
FRONTEND_URL=http://localhost:5173

# --- Gemini (LLM) ---
# Get a key from https://aistudio.google.com/app/apikey
# If left blank, the app still runs - AI summaries are simply marked "failed"
# and everything else keeps working.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Email (SMTP via Nodemailer) ---
# If left blank, emails are logged instead of sent (safe for local dev).
# Example values for Gmail with an App Password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-address@gmail.com
#   SMTP_PASS=your-16-char-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@clinic.example.com

# --- Google Calendar (OAuth2) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable the "Google Calendar API" for the project first.
# Redirect URI must exactly match what's configured in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/callback

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# --- Seed script (optional overrides) ---
SEED_ADMIN_EMAIL=admin@clinic.example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
